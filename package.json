{
  "name": "camtoyz-control",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server"
  ],
  "description": "Camtoyz Control — app de control remoto BLE para juguetes íntimos Camtoyz. Reemplazo de OmniRemote.",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "server:build": "npm run build --workspace @camtoyz/room-server",
    "server:start": "npm run start --workspace @camtoyz/room-server",
    "server:test": "npm run test --workspace @camtoyz/room-server"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^10.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "^52.0.0",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-ble-plx": "^3.2.1",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-webrtc": "^124.0.4",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^8.0.0",
    "typescript": "^5.3.3"
  },
  "//": "Codex: NO confíes en estas versiones a ciegas. Corre `npx expo install` para alinear módulos nativos con la SDK de Expo instalada. react-native-webrtc y socket.io-client se añaden en la Fase 5 (salas)."
}
