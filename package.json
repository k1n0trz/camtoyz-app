{
  "name": "camtoyz-app",
  "version": "1.0.1",
  "private": true,
  "workspaces": [
    "server"
  ],
  "description": "Camtoyz App — app de control remoto BLE para juguetes íntimos Camtoyz. Reemplazo de OmniRemote.",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "server:build": "npm run build --workspace @camtoyz/room-server",
    "server:start": "npm run start --workspace @camtoyz/room-server",
    "server:test": "npm run test --workspace @camtoyz/room-server",
    "release:verify-config": "node scripts/verify-release-config.mjs"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "^54.0.36",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-localization": "~17.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "//": "Codex: NO confíes en estas versiones a ciegas. Corre `npx expo install` para alinear módulos nativos con la SDK de Expo instalada. react-native-webrtc y socket.io-client se añaden en la Fase 5 (salas)."
}
