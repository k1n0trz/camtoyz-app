{
  "expo": {
    "name": "Camtoyz App",
    "slug": "camtoyz-app",
    "version": "1.0.1",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "scheme": "camtoyz-app",
    "icon": "./assets/icon/app-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAF0F5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "roomServerUrl": "https://app.camtoyz.com"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.camtoyz.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Camtoyz usa Bluetooth para conectarse con tu dispositivo.",
        "NSMicrophoneUsageDescription": "El control por sonido usa el micrófono para reaccionar al ambiente.",
        "NSCameraUsageDescription": "La interacción remota permite compartir video en una sala privada."
      }
    },
    "android": {
      "package": "com.camtoyz.app",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundColor": "#E8B4CB"
      },
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Camtoyz usa Bluetooth para conectarse con tu dispositivo."
        }
      ],
      "expo-dev-client",
      "expo-asset",
      "expo-secure-store",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Camtoyz usa la cámara solo cuando activas video en una sala privada.",
          "microphonePermission": "Camtoyz usa el micrófono para el control por sonido y las salas privadas."
        }
      ],
      "expo-localization"
    ]
  }
}
